+function booking_visit_details(array $input): array {
+    $details=[];
+    foreach (booking_visit_fields() as $key=>[$label,$choices]) {
+        $value=$input[$key]??'';
+        if ($value==='') continue;
+        if (!in_array($value,$choices,true)) throw new DomainException('Choose a listed option for '.$label.'.');
+        $details[$key]=$value;
+    }
+    return $details;
+}
+
+function booking_visit_notes(array $details,string $notes): string {
+    $lines=[];
+    foreach (booking_visit_fields() as $key=>[$label]) {
+        if (isset($details[$key])) $lines[]=$label.': '.$details[$key];
+    }
+    if ($notes!=='') $lines[]=$notes;
+    $result=implode("\n",$lines);
+    if (mb_len($result)>1900) throw new DomainException('Shorten the instructions to include the visit details.');
+    return $result;
+}
