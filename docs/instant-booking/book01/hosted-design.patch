+const detailsForm = document.querySelector('form[data-room-quote]');
+if (detailsForm) {
+    const status = detailsForm.querySelector('[data-quote-status]');
+    let pending;
+    detailsForm.addEventListener('change', async event => {
+        if (!event.target.matches('select[name^="options["], select[name="service_area"]')) return;
+        pending?.abort();
+        const request = new AbortController();
+        pending = request;
+        const url = new URL(detailsForm.dataset.roomQuote, window.location.href);
+        url.searchParams.set('summary', '1');
+        for (const [name, value] of new FormData(detailsForm)) {
+            if (name.startsWith('options[') || name === 'service_area') url.searchParams.set(name, value);
+        }
+        status.textContent = 'Updating your booking summary…';
+        try {
+            const response = await fetch(url, {signal: request.signal});
+            if (!response.ok) throw new Error();
+            const quote = await response.json();
+            if (request !== pending) return;
+            const template = document.createElement('template');
+            template.innerHTML = quote.html;
+            for (const body of document.querySelectorAll('[data-booking-summary]')) {
+                body.replaceChildren(template.content.cloneNode(true));
+            }
+            document.querySelector('.mobile-summary > summary').textContent = quote.caption;
+            status.textContent = '';
+        } catch {
+            if (request === pending) status.textContent = 'The summary could not update. Choose a time to recalculate your visit.';
+        }
+    });
+}
