Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
# Restore indexed marketing routes without a catch-all that masks genuine 404s.
# Relative substitutions keep the same rules safe in the isolated preview directory.
RewriteRule ^(?:platform/contact|contact)/?$ contact.html [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+[^?\ ]*(?:features|hosting|industries(?:/(?:tourism|gardening|technology|construction))?)\.html[?\ ]" [NC]
RewriteRule ^(features|hosting|industries(?:/(?:tourism|gardening|technology|construction))?)\.html$ $1 [R=301,L]
RewriteRule ^(features|hosting|industries(?:/(?:tourism|gardening|technology|construction))?)/$ $1 [R=301,L]
RewriteRule ^(features|hosting|industries(?:/(?:tourism|gardening|technology|construction))?)$ $1.html [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
# Account preview must never reuse the live waitlist configuration.
RewriteCond %{REQUEST_URI} ^/_accounts-preview/waitlist/ [NC]
RewriteRule ^ - [F,L]
RewriteRule ^(?:\.git|scripts|tests|docs|supabase|release)(?:/|$) - [F,L,NC]
RewriteRule ^account/(?:core|profile-core|services-core|enquiries-core|quotes-core|bookings-core|invoices-core|requests-core)\.php$ - [F,L,NC]
RewriteRule ^waitlist/(?:core|action-page|email)\.php$ - [F,L,NC]
RewriteRule (?:^|/)(?:\.[^/]+|[^/]+\.(?:sqlite|sqlite3|db|jsonl|csv|log|bak|md|ini|env|lock))$ - [F,L,NC]
</IfModule>

<IfModule mod_headers.c>
# Preview assets and static landing pages also remain excluded from indexing.
SetEnvIf Request_URI "^/_(?:accounts|waitlist)-preview(?:/|$)" faraios_preview
Header always set X-Robots-Tag "noindex, nofollow" env=faraios_preview
</IfModule>
